{
  "rewrites": [
    { "source": "/jiosaavn/api.php",     "destination": "/api/jiosaavn"            },
    { "source": "/api/jamendo/:path*",   "destination": "/api/jamendo?path=:path*" },
    { "source": "/api/audio",            "destination": "/api/audio"               },
    { "source": "/api/jiosaavn",         "destination": "/api/jiosaavn"            },
    { "source": "/lrclib/:path*",        "destination": "/api/lrclib?path=:path*"  },
    { "source": "/lyricsovh/:path*",     "destination": "/api/lyricsovh?path=:path*" },
    { "source": "/((?!api/).*)",         "destination": "/index.html"              }
  ],
  "functions": {
    "api/audio.ts":    { "maxDuration": 30 },
    "api/jiosaavn.ts": { "maxDuration": 15 },
    "api/jamendo.ts":  { "maxDuration": 15 }
  }
}
